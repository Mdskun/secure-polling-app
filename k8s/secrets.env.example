# Copy to k8s/secrets.env and fill in real values.
#   cp k8s/secrets.env.example k8s/secrets.env
#
# k8s/secrets.env is gitignored - never commit real secrets.
# Avoid '#' and leading/trailing whitespace inside values.
#
# Generate SECRET_KEY:   openssl rand -hex 32
# Generate POLL_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace-with-openssl-rand-hex-32
ADMINU=admin
ADMINP=replace-with-a-strong-admin-password-123
POLL_ENCRYPTION_KEY=replace-with-a-base64url-fernet-key